lativeOffset := constant - address asInteger >>> 2.	"auipc TargetAddressReg,((pcRelativeOffset bitAnd: 16rFFFFF000) >> 12).  	 ld       destReg,TargetAddressReg, ((pcRelativeOffset bitAnd: 16r0FFF)."	machineCode at: 0 				put: 2r0010111 "auipc opcode - U format"					+ (TargetAddressReg << 7) 					+ (pcRelativeOffset bitAnd: 16rFFFFF000). "upper 20 bits"	machineCode at: 1				put:  2r0000011 "ld - I Format"					+ (destReg << 7)					+ (2r011 << 12) "func3"					+ (TargetAddressReg << 15)					+ (pcRelativeOffset bitAnd:  16r00000FFF) << 20. "lower 12 bits"	^8! !!CogRV64Compiler methodsFor: 'generate machine code - support' stamp: 'KenD 8/3/2026 14:17'!setLiteralSize: sizeOfLiteral	"Set the size field.  The only complication is that in Smalltalk (operands at: 1) may be nil."	operands		at: 1		put: ((operands at: 1) ifNil: [0] ifNotNil: [:operand| operand bitClear: 30])			+ (sizeOfLiteral << 1)! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/13/2026 12:49'!concretizeAlignmentNops	<inline: true>	"See outputMachineCodeAt:"	self assert: machineCodeSize \\ 4 = 0.	machineCode at: 0 put:  2r0010011. "addi x0,x0,0 = NOP".	^machineCodeSize! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/28/2026 11:51'!concretizeCall	<inline: true>	"call 32 bit offset => 		  auipc x1, offset[31:12]		  jalr x1, x1, offset[11:0]		Signed 12 bit offset => relative +/- 2K"	| offset |	offset := ((operands at: 0) - address) signedIntFromLong64.	machineCode at: 0 				put: (self auipc: ReturnReg 						   offset:  ((offset bitAnd:  16rFFFFF000) >> 12)). "offset without lower 12 bits"	machineCode at: 1				put:  (self jalR: ReturnReg 						    addressReg: ReturnReg						    offset: (offset bitAnd:  16r00000FFF)). "lower 12 bits"	^8	! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/28/2026 11:54'!concretizeCallJumpFull: linkP	"Sizing/generating calls.		Jump targets can be to absolute addresses or other abstract instructions.		Generating initial trampolines instructions may have no maxSize and be to absolute addresses.		Otherwise instructions must have a machineCodeSize which must be kept to."	<inline: true>	| jumpTarget instrOffset returnReg|	<var: #jumpTarget type: #'AbstractInstruction *'>	jumpTarget := self longJumpTargetAddress.	instrOffset := self emitMoveCw: jumpTarget asUnsignedInteger intoR: TargetAddressReg at: 0.	linkP ifTrue: [ returnReg := ReturnReg ]  ifFalse: [ returnReg := ZeroReg ].	machineCode		at: instrOffset // 4		put: (self jalR: returnReg 				   addressReg: TargetAddressReg 				   offset: instrOffset).	self assert: instrOffset = self literalLoadInstructionBytes.	^instrOffset + 4! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/13/2026 12:50'!concretizeFill32	"fill with operand 0 according to the processor's endianness"	<inline: true>	machineCode at: 0 put: (operands at: 0).	^4! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/20/2026 12:04'!concretizeJumpLess	"If offset fits im immed12, do direvctly, 	 else if not less jump around longJump"	<inline: false>	| offset |	offset := self computeJumpTargetOffset.	self notYetImplemented. 	(offset bitAnd: 16r0FFF)	 ifTrue: [				]	 ifFalse: [		].! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/28/2026 11:51'!concretizeJumpLong	"CogRTLOpcodes>>initialize states:		  Call/Jump[Cond]Long must be generated in the same number of bytes 	  irrespective of displacement since their targets may be updated, but they 	 need only span 16Mb, the maximum size of the code zone.		So 24 bits.  RV64 gives 32 bit range with	  auipc TempAddrReg,(offset bitAnd: 16rFFFFF000) >> 12	  jal x0,TempAddrReg,(offset bitAnd: 16r0FFF)"	<inline: true>	| offset |	offset := (operands at: 0) - address.	self assert: ((offset bitAnd: 16rFFFFFFFF) = offset) ."32 bit offset"		machineCode at: 0 				put: (self auipc: TargetAddressReg 						   offset:  ((offset bitAnd:  16rFFFFF000) >> 12)). "offset without lower 12 bits"	machineCode at: 1				put:  (self jalR: ZeroReg 						    addressReg: TargetAddressReg 						    offset: (offset bitAnd:  16r00000FFF) ). "the lower 12 bits"		^8! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/28/2026 11:57'!concretizeJumpR	"jr reg => jalr x1,reg,0 ??offset unused??"	<inline: true>	machineCode		at: 0		put: (self jalR: ReturnReg addressReg: (operands at: 0) offset: 0). 	^4! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/23/2026 14:37'!concretizeLiteral	"Generate an out-of-line literal.  	 Copy the value and any annotation from the stand-in in the literals manager."	| literalAsInstruction literal |	<var: 'literal' type: #usqInt>	literalAsInstruction := cogit cCoerceSimple: (operands at: 0) to: #'AbstractInstruction *'.	literal := (self isAnInstruction: literalAsInstruction)				ifTrue: [literalAsInstruction address]				ifFalse: [self cCode: [literalAsInstruction asUnsignedInteger]							inSmalltalk: [literalAsInstruction]].	self assert: (dependent notNil and: [dependent opcode = Literal]).	dependent annotation ifNotNil:		[self assert: annotation isNil.		 annotation := dependent annotation].	dependent address ifNotNil: [self assert: dependent address = address].	dependent address: address.	machineCode at: 0 put: (literal bitAnd: 16rFFFFFFFF).	self literalSize = 4 ifTrue:		[^4].	machineCode at: 1 put: (literal >> 32).	^8! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/28/2026 12:01'!concretizeMoveRR	"Will get inlined into concretizeAt: switch."	<inline: true>	| sourceReg destReg |	sourceReg := operands at: 0.	destReg     := operands at: 1.	"ADDI destReg, srcReg, 0"	machineCode		at: 0		put: (self addI: destReg srcReg: sourceReg immed: 0).	^4! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/23/2026 14:37'!concretizeMoveRRd	<inline: true>	"FMV.X.D destReg, srcReg 	  Integer Reg to Double Float Reg	  Just the bits - NO CONVERSION"	machineCode		at: 0		put: 2r1010011 "fmv.x.d - R Format"			+ ((operands at: 1) << 7) "destReg"			"+ (0 << 12) 'func3'"			+ ((operands at: 0) << 15) "srcReg"			"+ (0 << 20) srcReg2"			+ (2r1110001 << 25). "func7"	"cogit processor disassembleInstructionAt: 0 In: machineCode object"	^4! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/23/2026 14:37'!concretizeMoveRdR	<inline: true>	"FMV.D.X destReg, srcReg 	 Double Float Reg to Integer Reg	 Just the bits - NO CONVERSION"	machineCode		at: 0		put: 2r1010011 "fmv.d.x - R Format"			+ ((operands at: 1) << 7) "destReg"			"+ (0 << 12) 'func3'"			+ ((operands at: 0) << 15) "srcReg"			"+ (0 << 20) srcReg2"			+ (2r1111001 << 25). "func7"	"cogit processor disassembleInstructionAt: 0 In: machineCode object"	^4! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 8/28/2026 12:02'!concretizeNop	<inline: true>	"add ZeroReg,ZeroReg,0"		machineCode at: 0 put: 2r0110011.	^4	! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CogRV64Compiler class	instanceVariableNames: ''!!CogRV64Compiler class methodsFor: 'documentation' stamp: 'KenD 7/5/2026 12:18'!callingC^' RV64G = General [IMAFD = Integer/Multiply/Atomic/Float/DoubleFloat]- Little Endian; 64 bit = 8 byte registers- Instruction size is 32 bits [except RV64C = Compact; not done here]- Stack Grows Down; 16 byte (quad word) aligned; low 4 addr bits are zero**  RV64G Calling Convention- Arguments: Up to 8 integer [A0-A7] and 8 floats [FA0-FA7] in registers- Args smaller than a register are passed in the lest-significant bits- When args are twice the size of a register, they are passed on the stack,and are naturally aligned. - Args more than twice register size are passed by reference.- If args are thought of as a C struct with pointer aligned fields, the are regs are a shadowof the 1st 8 pointer-words of the struct. If arg index i < 8 are floats, they are passedin the corresponding float register [FAi vs Ai]. HOWEVER, float args which are part ofa union  or array are passed in the integer registers, as are args to variadic functions.- Args beyond 8 are passed on the stack with SP pointing to the first arg not passedin a register.- Ints smaller than register size are sign extended in upper bits** RETURN VALUES- integers in A0/A1, floats in FA0/FA1. BUT float returns in float regs ONLY if prim or part of a result consisting of 1 or 2 float values, OTHERWISE in integer regs.- Larger returns are passed in memory which is allocated by the caller andthe pointer address passed as an implicit first parameter of the callee.x0 = ZERO [hardwired]x1 = Return Addressx2 = Stack Pointerx8 = Frame Pointerx3 = Globals Pointerx4 = Thread Pointerx10..x17 = A0..A7    Integer Args ; A0..A1 return valuesf10..f17 = FA0..FA7  Float Args;  FA0..FA1 return valuessize in 	  Cbytes	Type===	===  1		char  2		short  4		int  8		long    [Nota Bene: 4 bytes in RV32]  8		long long  8		void*  4		float  8		double 16		long double'! !!CogRV64Compiler class methodsFor: 'documentation' stamp: 'KenD 8/7/2026 15:11'!instructionIdioms^'RV64G instruction idioms	RV64 favors PC relaive addressing.  Load of an Immediate value requires a variety of instruction sequences.So use #OutOfLineLiteralsManager class!!AUIPC + JALR -> target any 32 bit relative addressAUIPC + Load/Store -> access any 32 bit PC relaive address=> +/- 2GB range	JAL: Jump And Link instruction has a 20 bit signed offset   The offset is left-shifted 1 bit=> +/- 1 MB range	JALR: Jump And Link Register has a 12 bit signed offset used _unshifted_  but the low bit is set by HW to zero.  So low bit could be used in encoding function call vs pointer.  => +/- 2K rangeConditional Branches have 12 bit offset left shift 1 bit => +/- 4K rangeLoad & Store instructions use _unshifted_ 12 bit immediate offsets => +/- 2K rangeTo get 32-bit immediate in a register: [ A ]  2 instructions if neither upper-20 or lower-12 have high-bit set, e.g.    lui      destReg,0x12341			# upper-20-bits    xori    destReg,destReg,0x234	# lower-12-bits  [range: -2048..2047]    ==> 0x12341234[ B ] otherwise 5 instructions.  E.g.    lui     destReg,0x0FADE		 # avoid high bit sign extend    slli    destReg,destReg,4		 # upper 32 bits zero still    lui     tempReg,0x0CAFE		 # within range    srli    tempReg,tempReg,12	 # shift into position; upper bits zero    xor   destReg,destReg,tempReg # pieces back together - ADD also works    => 0xFADECAFEADDI DestReg,0xFFF to load -1 into a register in 1 instruction FAILS!! -2048 minADDI DestReg, SrcReg, 0, to copy values from one register to another.ADDI X0, X0, 0  is NOOPAll RV54 arithmetic is modulo 46 bits wituOUT trap on overflow.E.g. overflow check for  c := a + b ==> (c < a) ? add destC, srcA, srcB bltu destC, srcA, overFlowPesudo-op			Expansion				Description=======			=======				=======nop					addi zero,zero,0		No operationmv rd, rs1			addi rd, rs, 0			Copy registernot rd, rs1			xori rd, rs, -1			One"s complementneg rd, rs1			sub rd, x0, rs			Two"s complementnegw rd, rs1		subw rd, x0, rs			Two"s complement Wordsext.w rd, rs1		addiw rd, rs, 0			Sign extend Wordseqz rd, rs1			sltiu rd, rs, 1			Set if = zerosnez rd, rs1			sltu rd, x0, rs			Set if !!= zerosltz rd, rs1			slt rd, rs, x0			Set if < zerosgtz rd, rs1			slt rd, x0, rs			Set if > zerofmv.s frd, frs1		fsgnj.s frd, frs, frs		Single-precision movefabs.s frd, frs1		fsgnjx.s frd, frs, frs		Single-precision absolute valuefneg.s frd, frs1		fsgnjn.s frd, frs, frs		Single-precision negatefmv.d frd, frs1		fsgnj.d frd, frs, frs		Double-precision movefabs.d frd, frs1		fsgnjx.d frd, frs, frs	D	ouble-precision absolute valuefneg.d frd, frs1		fsgnjn.d frd, frs, frs		Double-precision negatebeqz rs1, offset		beq rs, x0, offset		Branch if = zerobnez rs1, offset		bne rs, x0, offset		Branch if ≠ zeroblez rs1, offset		bge x0, rs, offset		Branch if ≤ zerobgez rs1, offset		bge rs, x0, offset		Branch if ≥ zerobltz rs1, offset		blt rs, x0, offset			Branch if < zerobgtz rs1, offset		blt x0, rs, offset			Branch if > zerobgt rs, rt, offset		blt rt, rs, offset			Branch if >ble rs, rt, offset		bge rt, rs, offset		Branch if <=bgtu rs, rt, offset	bltu rt, rs, offset		Branch if >, unsignedbleu rs, rt, offset	bltu rt, rs, offset		Branch if <=, unsignedj offset				jal x0, offset			Jumpjr offset				jal x1, offset			Jump registerNOTE:  https://riscv-optimization-guide.riseproject.dev'! !!CogRV64Compiler class methodsFor: 'documentation' stamp: 'KenD 7/22/2026 13:17'!learnMe	^'I do Cog JIT for RV64G (riscv64 General) processorsIn addition to my (CogRV64Compiler) code, pease read:RV64G Instruction Formats at riscv.org: 	https://docs.riscv.org/reference/home/index.html	 #RegisterAllocatingCogit and superclasses #CogRTLOpcodes class>>initialize  comment #CogAbstractInstruction  class comment #CogRV64Compiler>>initializeAbstractRegisters  #CogAbstractRegisters  class comment #Cogit class>>structureOfACogMethod & "documentation" method category #VMClass class>>initializationOptionNamesAnd of course the README.md at:     https://github.com/OpenSmalltalk/opensmalltalk-vm'! !!CogRV64Compiler class methodsFor: 'documentation' stamp: 'KenD 7/15/2026 12:51'!registerUse^'32 Integer and 32 Float Registers======================C ABI:  SEE #CogRV64Compile>>initilizeRV64RegisterAliases====x0 = ZERO [hardwired]x1 = Return Addressx2 = Stack Pointer [callee]x3 = Globals Pointerx4 = Thread Pointerx5..x7 = T0..T2 Temporariesx8 = S0 = FP  Frame Pointer [callee]x9 = S1  Saved [callee]x10..x17 = A0..A7    Integer Args