12)		+ (addrR << 15)		+ (dataR << 20)		+ ((offset bitAnd: 16rFFE0) << 15) ! !!CogRV64Compiler methodsFor: 'rv64 instructions - store' stamp: 'KenD 8/26/2026 14:32'!shI: addrR dataR: dataR immed: offset	"Store Half (16) Immediate S-Format - 12 bit signed offset"	<inline: true>	^   2r0100011 		+ ((offset bitAnd: 16r001F) << 7)		+ (16r1 << 12)		+ (addrR << 15)		+ (dataR << 20)		+ ((offset bitAnd: 16rFFE0) << 15) ! !!CogRV64Compiler methodsFor: 'rv64 instructions - store' stamp: 'KenD 8/26/2026 14:32'!swI: addrR dataR: dataR immed: offset	"Store Word (32) Immediate S-Format - 12 bit signed offset"	<inline: true>	^   2r0100011 		+ ((offset bitAnd: 16r001F) << 7)		+ (16r2 << 12)		+ (addrR << 15)		+ (dataR << 20)		+ ((offset bitAnd: 16rFFE0) << 15) ! !!CogRV64Compiler methodsFor: 'rv64 instructions - load' stamp: 'KenD 8/26/2026 14:13'!lbI: destR srcReg: srcR immed: iVal	"Load Byte (8) Immediate I-Format"	<inline: true>	^   2r0000011 		+ (destR << 7)		+ (16r0 << 12)		+ (srcR << 15)		+ (iVal << 20)  "12 bits"! !!CogRV64Compiler methodsFor: 'rv64 instructions - load' stamp: 'KenD 8/26/2026 14:17'!lbuI: destR srcReg: srcR immed: iVal	"Load Byte (8) Unsigned Immediate I-Format"	<inline: true>	^   2r0000011 		+ (destR << 7)		+ (16r4 << 12)		+ (srcR << 15)		+ (iVal << 20)  "12 bits"! !!CogRV64Compiler methodsFor: 'rv64 instructions - load' stamp: 'KenD 8/26/2026 14:55'!ldI: destR srcReg: srcR immed: iVal	"Load DoubleWord (64) Immediate I-Format"	<inline: true>	^   2r0000011 		+ (destR << 7)		+ (16r3 << 12)		+ (srcR << 15)		+ (iVal << 20)  "12 bits"! !!CogRV64Compiler methodsFor: 'rv64 instructions - load' stamp: 'KenD 8/26/2026 14:54'!lduI: destR srcReg: srcR immed: iVal	"Load DoubleWord (64) Unsigned Immediate I-Format"	<inline: true>	^   2r0000011 		+ (destR << 7)		+ (16r6 << 12)		+ (srcR << 15)		+ (iVal << 20)  "12 bits"! !!CogRV64Compiler methodsFor: 'rv64 instructions - load' stamp: 'KenD 8/26/2026 1