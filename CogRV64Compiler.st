7'!setLiteralSize: sizeOfLiteral	"Set the size field.  The only complication is that in Smalltalk (operands at: 1) may be nil."	operands		at: 1		put: ((operands at: 1) ifNil: [0] ifNotNil: [:operand| operand bitClear: 30])			+ (sizeOfLiteral << 1)! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 7/30/2026 12:43'!concretizeCall	<inline: true>	"call 32 bit offset => 		  auipc x1, offset[31:12]		  jalr x1, x1, offset[11:0]"	| offset |	offset := ((operands at: 0) - address) signedIntFromLong64.	machineCode at: 0 				put: 2r0010111 "auipc opcode - U format"					+ (ReturnReg << 7) "X1 is ReturnAddr = Link"					+ (offset bitAnd:  16rFFFFF000). "offset without lower 12 bits"	machineCode at: 1				put:  2r1100111 "jalr opcode - I Format"					+ (ReturnReg << 7)					"+ (0 << 12) 'func3'"					+ (ReturnReg << 15)					+ (offset bitAnd:  16r00000FFF) << 20. "lower 12 bits"	^8	! !!CogRV64Compiler methodsFor: 'generate machine code - concretize' stamp: 'KenD 7/30/2026 18:43'!concretizeJumpLong	"CogRTLOpcodes>>initialize states:		  Call/Jump[Cond]Long must be generated in the same number of bytes 	  irrespective of displacement since their targets may be updated, but they 	 need only span 16Mb, the maximum size of the code zone.		So 24 bits.  RV64 gives 32 bit range with	  auipc TempAddrReg,(offset bitAnd: 16rFFFFF000) >> 12	  jal x0,TempAddrReg,(offset bitAnd: 16r0FFF)"	<inline: true>	| offset |	offset := (operands at: 0) - address.	self assert: ((offset bitAnd: 16rFFFFFFFF) = offset) ."32 bit offset"		machineCode at: 0 				put: 2r0010111 "auipc opcode - U format"					+ (TempAddrReg << 7) 					+ (offset bitAnd:  16rFFFFF000). "offset without lower 12 bits"	machineCode at: 1				put:  2r1100111 "jalr opcode - I Format"					"+ (ZeroReg << 7)"					"+ (0 << 12) 'func3'"					+ (TempAddrReg << 15)					+ (offset bitAnd:  16r00000FFF) << 20. "the lower 12 bits"		^8! !!CogRV64Compiler methodsFor: 'gen