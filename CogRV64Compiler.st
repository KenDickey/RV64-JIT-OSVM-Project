	ABIResultRegHigh	:= Arg1.				TargetAddressReg := Tmp1.  "auxpc et al"	TempReg			:= Tmp2.	RISCTempReg		:= Tmp3.	Overflow			:= Tmp4.	OverflowTemp1 	:= Tmp5. 	OverflowTemp2	:= Tmp6.  	FPReg				:= FrameReg.	SPReg				:= Sav10.  "Smalltalk SP; ISA StackPtr reg is X2"	VarBaseReg			:= Sav11.		ConcreteVarBaseReg := VarBaseReg.	LinkReg			:= ReturnReg. "X1"					NativeSPReg		:= StackReg.	"Sav0 is C StackPointer"				Extra0Reg			:= Sav1. "CalleE saved"	Extra1Reg			:= Sav2.	Extra2Reg			:= Sav3.	Extra3Reg			:= Sav4.	Extra4Reg			:= Sav5.	Extra5Reg			:= Sav6.	Extra6Reg			:= Sav7.	Extra7Reg			:= Sav8.	Extra8Reg			:= Sav9.	"Sav10 for Smalltalk SP,	 Sav11 for VarBaseReg."									CArg0Reg := Arg0.	CArg1Reg := Arg1.	CArg2Reg := Arg2.	CArg3Reg := Arg3.	CArg4Reg := Arg4.	CArg5Reg := Arg5.	CArg6Reg := Arg6.	CArg7Reg := Arg7.	NumRegisters := 32.	DPFPReg0		:= F0. "Temp regs F0..7"	DPFPReg1		:= F1.	DPFPReg2		:= F2.	DPFPReg3		:= F3.	DPFPReg4		:= F4.	DPFPReg5		:= F5.	DPFPReg6		:= F6.	DPFPReg7		:= F7.	"Float Arg Regs: Farg0..7 = F10..17"	DPFPReg8		:= F28. "Temp regs F28..31"	DPFPReg9		:= F29.	DPFPReg10		:= F30.	DPFPReg11		:= F31.	"@@Revisit@@"	DPFPReg12		:= FArg0.	DPFPReg13		:= FArg1.	DPFPReg14		:= FArg2.	DPFPReg15		:= FArg3.	NumFloatRegisters := 32.		ABICalleeSavedRegisterMask := 		(self registerMaskFor: X2 and: X8 and: X9 and: X10 and: X18)		+ (self registerMaskFor: X19 and: X20 and: X21 and: X22 and: X23)		+ (self registerMaskFor: X24 and: X25 and: X26 and: X27 and: X23).										ABICallerSavedRegisterMask := 		((self registerMaskFor: X0 and: X5 and: X6 and: X7)		+ (self registerMaskFor: X10 and: X11 and: X12 and: X13 and: X14 and: X15)).			CallerSavedRegisterMask := 		ABICallerSavedRegisterMask  "Use Temps rather than Saves???"			bitAnd: (self registerMaskFor: ClassReg 										and: ReceiverResultReg 										and: SendNumArgsReg 										and: Arg0Reg 										and: Arg1Reg 										and: SPReg)		+ (self registerMaskFor: X16 and: X17 and: X28 and: X29 and: X30 and: X31).									! !!CogRV64Compiler class methodsFor: 'translation' stamp: 'KenD 7/4/2026 11:42'!ISA	"Answer the name of the ISA the receiver implements."	"G is shorthand for the 'IMAFD' a.k.a. 'General' implementation:	  Integer	  Multiply	  Atomic	  Float	  Double-float	  plus CSR & fenced memory access	"	^ #RV64G! !!CogRV64Compiler class methodsFor: 'translation' stamp: 'KenD 7/9/2026 12:15'!identifyingPredefinedMacros	"RV64G = General => Integer + Multiply + Atomic + Float +Double	 plus CSR & fenced memory access.		 C = Compact => 16 bit subset, like Aarch64 'Thumb', currently UNUSED"		^#( '__riscv64__'  'RISCV64'  '__rv64g__' '__rv64gc__')! !!CogRV64Compiler class methodsFor: 'translation' stamp: 'KenD 7/12/2026 14:37'!wordSize	"This is a 64-bit ISA"	^8 "bytes per register"! !!CogRV64Compiler class methodsFor: 'accessing class hierarchy' stamp: 'KenD 7/2/2026 13:30'!literalsManagerClass	^OutOfLineLiteralsManagerFor64Bits! !!CogRV64Compiler class methodsFor: 'trampoline support' stamp: 'KenD 7/12/2026 14:44'!numTrampolines	^ 2 "ceFlushICache, and optionally ceFlushDCache" "@@REVISIT@@"! !CogRV64Compiler initialize!