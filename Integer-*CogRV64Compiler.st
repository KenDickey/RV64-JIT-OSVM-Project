'From Squeak6.2alpha of 23 August 2026 [latest update: #23984] on 7 September 2026 at 7:28:26 am'!!Integer methodsFor: '*CogRV64Compiler' stamp: 'KenD 9/7/2026 07:27'!isImmed12	"Answer true if I fit in 12 bits, signed. Mask sign bit."	| bits |	(self < 0) 		ifTrue: [ bits := self negated ]		ifFalse:[ bits := self ].	^(bits = (bits bitAnd: 16r07FF))	! !!Integer methodsFor: '*CogRV64Compiler' stamp: 'KenD 9/7/2026 07:27'!isImmed20	"Answer true if I fit in 20 bits, signed. Mask sign bit."	| bits |	(self < 0) 		ifTrue: [ bits := self negated ]		ifFalse:[ bits := self ].	^(bits = (bits bitAnd: 16r07FFFF))	! !